          {
            "name": "dates",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "passengerCount",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "seatClass",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/reservations/flights": {
      "post": {
        "summary": "항공 좌석 예약",
        "security": [
          {
            "BearerAuth": []
