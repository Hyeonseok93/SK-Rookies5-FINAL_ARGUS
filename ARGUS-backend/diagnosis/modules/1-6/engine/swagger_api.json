                  },
                  "passengerPassport": {
                    "type": "string"
                  },
                  "passengerBirthdate": {
                    "type": "string"
                  },
                  "totalPrice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
